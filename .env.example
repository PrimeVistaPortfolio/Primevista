# ── Database ────────────────────────────────────────────────────────────────
# apps/web/.env.local (this is where web actually reads it from)
MONGODB_URI=mongodb://localhost:27017/primevista

# ── Auth ────────────────────────────────────────────────────────────────────
# apps/web/.env.local — signs/verifies admin JWTs
JWT_SECRET=replace-with-a-long-random-string

# ── Cloudinary (media storage) ─────────────────────────────────────────────
# apps/web/.env.local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (optional — inquiry notifications) ───────────────────────────────
# apps/web/.env.local. Leave SMTP_HOST blank to skip sending emails entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@primevista.dev
ADMIN_NOTIFICATION_EMAIL=

# ── Site ────────────────────────────────────────────────────────────────────
# apps/web/.env.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin seed script (apps/web/scripts/seedAdmin.js) ──────────────────────
# apps/web/.env.local — first admin login, change the password after seeding
SEED_ADMIN_NAME=Site Owner
SEED_ADMIN_EMAIL=admin@primevista.dev
SEED_ADMIN_PASSWORD=ChangeMe123!

# ── Admin app (apps/admin/.env.local) ──────────────────────────────────────
# Base URL of the web app's API that admin proxies requests to
WEB_API_URL=http://localhost:3000
